# URL local de FastAPI en la VPS. Usa la URL pública si la API solo está
# disponible a través de un proxy inverso.
MONITOR_API_URL=http://127.0.0.1:8000/health
MONITOR_HTTP_TIMEOUT_SECONDS=8
MONITOR_INTERVAL_SECONDS=60
MONITOR_DISK_PATH=/

CPU_THRESHOLD_PERCENT=85
MEMORY_THRESHOLD_PERCENT=90
DISK_THRESHOLD_PERCENT=90
ALERT_COOLDOWN_SECONDS=1800

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_USER=tu-cuenta@example.com
SMTP_PASSWORD=tu-contrasena-de-aplicacion
SMTP_FROM=tu-cuenta@example.com
ALERT_EMAIL_TO=al2223106122@gmail.com